      "name": "Redactar correo con IA",
      "notesInFlow": true,
      "onError": "continueErrorOutput",
      "notes": "La IA solo redacta el texto. Stock, faltante y prioridad ya fueron calculados por el workflow."
    },
    {
      "parameters": {
