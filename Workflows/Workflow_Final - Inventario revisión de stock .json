      "id": "1811a467-5d35-488e-ad5f-226190958725",
      "name": "Modelo Gemini - seleccionar credencial",
      "notesInFlow": true,
      "credentials": {
        "googlePalmApi": {
          "id": "Laf1tuK4BWddSpHD",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "notes": "Selecciona tu credencial Gemini y confirma que el modelo esté disponible en tu cuenta."
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"asunto\": {\n      \"type\": \"string\"\n    },\n    \"cuerpo\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"asunto\",\n    \"cuerpo\"\n  ],\n  \"additionalProperties\": false\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        208,
        0
      ],
      "id": "35668cf2-e5d0-4690-afa4-71d00e7a6dcb",
      "name": "Contrato de respuesta",
      "notesInFlow": true,
      "notes": "Obliga a devolver asunto y cuerpo. No garantiza que el texto sea fiel a los datos."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Combina el texto de la IA (si es válido) con los datos reales de Supabase.\nconst alerta = $('Registrar alerta en Supabase').item.json;\nconst esc = s => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');\nconst recibido = $json;\nlet r = recibido.output ?? recibido.text ?? recibido;\nif (typeof r === 'string') { try { r = JSON.parse(r); } catch { r = null; } }\nconst objeto = r !== null && typeof r === 'object' && !Array.isArray(r);\nconst valido = objeto\n  && Object.keys(r).length === 2\n  && typeof r.asunto === 'string' && r.asunto.trim().length > 0 && r.asunto.length <= 120\n  && typeof r.cuerpo === 'string' && r.cuerpo.trim().length > 0 && r.cuerpo.length <= 1200;\nconst asunto = valido\n  ? r.asunto.replace(/[\\r\\n]+/g, ' ').trim()\n  : `[${alerta.prioridad}] Reponer ${alerta.producto}`;\nconst texto = valido ? r.cuerpo.trim() : (alerta.mensaje ?? '');\nconst filas = [\n  ['Producto', alerta.producto],\n  ['Stock actual', alerta.stock],\n  ['Stock mínimo', alerta.stock_minimo],\n  ['Faltante', alerta.faltante],\n  ['Prioridad', alerta.prioridad],\n  ['Estado', alerta.estado_stock],\n  ['Acción', alerta.accion],\n  ['ID de alerta', alerta.alerta_id]\n].map(([k, v]) => `<tr><td style=\"padding:6px 12px;border:1px solid #cbdfe9;background:#f1f8fb\"><b>${esc(k)}</b></td><td style=\"padding:6px 12px;border:1px solid #cbdfe9\">${esc(v)}</td></tr>`).join('');\nconst nota = valido\n  ? 'Texto redactado con IA (Gemini). Los datos de la tabla provienen de Supabase.'\n  : 'Aviso generado con plantilla fija porque la IA no entregó una respuesta utilizable. Los datos provienen de Supabase.';\nconst html = `<div style=\"font-family:Arial,sans-serif;font-size:14px;color:#14283d\"><p>${esc(texto).replace(/\\n/g,'<br>')}</p><table style=\"border-collapse:collapse\">${filas}</table><p style=\"color:#52677a;font-size:12px\">${nota}</p></div>`;\nreturn { json: { asunto, html, modo: valido ? 'ia' : 'plantilla', alerta_id: alerta.alerta_id } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        384,
        176
      ],
      "id": "3682ac05-4f31-44ac-a760-427f345f5ea5",
      "name": "Armar correo",
      "notesInFlow": true,
      "notes": "Recibe tanto la salida correcta como la de error de la cadena. Si la respuesta no cumple el contrato usa una plantilla fija."
    },
