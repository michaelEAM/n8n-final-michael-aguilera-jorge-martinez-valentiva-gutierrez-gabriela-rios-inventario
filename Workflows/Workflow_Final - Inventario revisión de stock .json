      "name": "Enviar correo de alerta",
      "notesInFlow": true,
      "webhookId": "6ac472ff-a5d0-40c3-8200-539f2815c9ae",
      "credentials": {
        "gmailOAuth2": {
          "id": "fhLpZfMLhR1o958m",
          "name": "Gmail account"
        }
      },
