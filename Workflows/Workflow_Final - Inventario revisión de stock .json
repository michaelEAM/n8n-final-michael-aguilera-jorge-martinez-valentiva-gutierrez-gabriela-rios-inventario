    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Gmail devuelve solo el id del mensaje. Se restaura la alerta para que \"Confirmar registro\" funcione igual que antes.\nconst alerta = $('Registrar alerta en Supabase').item.json;\nconst correo = $('Armar correo').item.json;\nreturn { json: { ...alerta, correo_enviado: Boolean($json.id), correo_modo: correo.modo } };"
      },
